# ---- Vonage application (Voice API) -------------------------------------
# Dashboard > Applications > your app. Enable the "Voice" capability.
VONAGE_APPLICATION_ID=
# Private key downloaded when the application was created (never commit it).
VONAGE_PRIVATE_KEY_PATH=./private.key
# Alternative for containers: the PEM body with "\n" escapes (leave empty when using the file).
VONAGE_PRIVATE_KEY=

# Caller ID. Free trial: use Vonage's test caller id 123456789 and call only the
# number you registered at signup. Paid accounts: your Vonage number (E.164, no +).
VONAGE_FROM_NUMBER=123456789

# ---- Vonage account (Application API, used to auto-update webhook URLs) --
# Dashboard > API settings. Needed for the automatic webhook sync.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Optional: Dashboard > API settings > "Signature secret". When set, webhook
# requests must carry a valid Vonage JWT signature.
VONAGE_SIGNATURE_SECRET=

# ---- Public URL / tunnel ---------------------------------------------------
# TUNNEL=auto  : start a Cloudflare quick tunnel when PUBLIC_URL is empty and cloudflared exists
# TUNNEL=quick : always start the quick tunnel
# TUNNEL=none  : never start a tunnel (use PUBLIC_URL)
TUNNEL=auto
# Fixed public base URL (named tunnel / ngrok / your own domain). Leave empty for quick tunnels.
PUBLIC_URL=
# Set to 0 to stop the server from touching the Vonage application webhooks.
SYNC_WEBHOOKS=1
CLOUDFLARED_BIN=cloudflared
# Extra cloudflared args, e.g. "--protocol http2" on networks that block QUIC/UDP.
CLOUDFLARED_ARGS=

# ---- Gemini Live (Google AI Studio API key) --------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Any Gemini TTS voice name (Kore, Puck, Aoede, Charon, Fenrir, Leda, Orus, Zephyr, ...)
GEMINI_VOICE=Kore
AGENT_NAME=AIアシスタント
# Appended to the system prompt for every call (persona, company name, opening hours, ...).
AGENT_EXTRA_INSTRUCTIONS=
# Objective used when someone calls your Vonage number.
INBOUND_OBJECTIVE=

# ---- Call behaviour ---------------------------------------------------------
# Only these destinations may be dialled while set (comma separated, E.164). Recommended during trial.
ALLOWED_TO_NUMBERS=
MAX_CONCURRENT_CALLS=1
CALL_MAX_SECONDS=900
RINGING_TIMEOUT=45
# Spoken by Vonage TTS before the AI joins (set ANNOUNCE_AI=0 to skip).
ANNOUNCE_AI=1
ANNOUNCE_TEXT=AIアシスタントからのお電話です。
# 8000 | 16000 | 24000 (16000 recommended)
VONAGE_AUDIO_RATE=16000
# Print transcripts to the server log as they arrive.
TRANSCRIPT_LOG=0

# ---- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8090
# Token for the local admin API (/calls ...). Auto-generated per start when empty;
# the CLI reads it from .runtime/state.json.
ADMIN_TOKEN=
# Require the Authorization header on the Vonage media WebSocket (recommended).
WS_AUTH=1
WS_AUTH_TOKEN=
