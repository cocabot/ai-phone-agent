# ===== Vonage =====
# Vonage Dashboard > Applications で作成したアプリ（Voice有効）
VONAGE_APPLICATION_ID=
# アプリ作成時にダウンロードした秘密鍵のファイルパス（中身をここに貼らない）
VONAGE_PRIVATE_KEY_PATH=./private.key
# Dashboard トップの API key / API secret（Webhook URL の自動設定に使用）
VONAGE_API_KEY=
VONAGE_API_SECRET=
# 発信元にする Vonage の番号（E.164、+ は有っても無くても可）
VONAGE_FROM_NUMBER=

# ===== Gemini (Google AI Studio) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Kore / Puck / Charon / Aoede / Fenrir / Leda / Orus / Zephyr など
GEMINI_VOICE=Kore

# ===== 公開URL（Cloudflare Tunnel）=====
# auto: PUBLIC_URL があればそれ、無ければ cloudflared quick tunnel を自動起動
# cloudflared / metrics / none も指定可（README参照）
TUNNEL=auto
# 固定ドメイン（named tunnel 等）を使う場合だけ設定。例: https://phone.example.com
PUBLIC_URL=
# 別プロセスで cloudflared を動かす場合: その --metrics アドレス（例: 127.0.0.1:20241）
CLOUDFLARED_METRICS=
# QUIC(UDP 7844)が塞がれている環境では http2 を指定
CLOUDFLARED_PROTOCOL=
# URLが変わるたびに Vonage アプリの Answer/Event URL を API で自動更新
VONAGE_AUTO_SYNC=1

# ===== 通話 =====
AGENT_NAME=AIアシスタント
# 着信時の役割（空なら受付係として用件を聞き取る）
INBOUND_GOAL=
# 全通話に追加する指示（任意）
EXTRA_INSTRUCTIONS=
# 発信を許可する国番号（カンマ区切り）
ALLOWED_COUNTRY_CODES=81
# 指定すると、この番号以外へは発信しない（トライアル中の誤発信防止に推奨）例: +819012345678
CALL_ALLOWLIST=
MAX_CALL_SECONDS=600
RINGING_TIMEOUT=45
MAX_CONCURRENT_CALLS=1
# Vonage<->サーバー間の音声サンプルレート 8000 / 16000 / 24000
AUDIO_RATE=16000

# ===== サーバー =====
PORT=8090
HOST=0.0.0.0
# ローカルAPIをトークンで保護したい場合（未設定なら127.0.0.1からのみ許可）
AGENT_API_TOKEN=
# echo にするとGeminiを使わず音声をそのまま返す（回線テスト用）
BRIDGE=
