PORT=3000

# Private MCP access for development/testing.
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+8150xxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_PROJECT_ID=proj_...
OPENAI_WEBHOOK_SECRET=whsec_...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Used to authenticate the short context sent from Twilio to OpenAI over SIP.
CALL_CONTEXT_SECRET=replace-with-a-different-long-random-secret
